{
  "name": "yeetpowder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Yeetpowder: a 3D browser game (Three.js, TypeScript, Vite). Use python tools/dev.py for every command.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "duel": "node tools/duel.mjs",
    "duel:server": "vite build --ssr server/main.ts --outDir build/server --emptyOutDir && node build/server/main.js"
  },
  "dependencies": {
    "peerjs": "1.5.5",
    "qrcode-generator": "2.0.4",
    "three": "0.186.1",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
